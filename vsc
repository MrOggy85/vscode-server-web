#!/usr/bin/env bash
set -euo pipefail

# vsc — manage VS Code serve-web instances created by run.sh
#
# An "instance" is a docker container named `vscode-<folder>-<hash>` (see run.sh).
# Each instance mounts:
#   - the project folder as a bind mount at /workspace  (your source code — never deleted here)
#   - named volumes (vscode-cli, vscode-claude-credentials) which are SHARED across instances
#
# Commands:
#   vsc ls                       list instances (status, port, folder, volumes)
#   vsc stop      <selector>     stop and remove a running instance (container only)
#   vsc rm-volumes <selector>    remove the named volumes attached to an instance
#   vsc destroy   <selector>     stop the instance, then remove its volumes
#
# <selector> matches an exact container name, or a substring of the container
# name or the project folder name. Ambiguous matches are rejected.
#
# Flags:
#   -y, --yes      skip confirmation prompts
#   -f, --force    (rm-volumes/destroy) also remove volumes shared with other instances

PREFIX="vscode-"

err()  { printf '%s\n' "$*" >&2; }
die()  { err "Error: $*"; exit 1; }
note() { printf '>> %s\n' "$*"; }

require_docker() { command -v docker >/dev/null 2>&1 || die "docker not found on PATH"; }

# ---- introspection helpers -------------------------------------------------

# All instance containers (running + stopped).
instances() {
  docker ps -a --filter "name=${PREFIX}" --format '{{.Names}}' \
    | while IFS= read -r n; do [[ "$n" == ${PREFIX}* ]] && printf '%s\n' "$n"; done
}

status_of() { docker inspect "$1" --format '{{.State.Status}}' 2>/dev/null || echo unknown; }

# Published host port; falls back to the PORT env baked into the container.
port_of() {
  local p
  p=$(docker inspect "$1" --format \
        '{{range $cfg := .NetworkSettings.Ports}}{{range $cfg}}{{.HostPort}}{{end}}{{end}}' 2>/dev/null)
  [[ -n "$p" ]] && { printf '%s' "$p"; return; }
  docker inspect "$1" --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null \
    | sed -n 's/^PORT=//p' | head -n1
}

# Host path bind-mounted at /workspace (the project folder).
folder_of() {
  docker inspect "$1" --format \
    '{{range .Mounts}}{{if eq .Destination "/workspace"}}{{.Source}}{{end}}{{end}}' 2>/dev/null
}

# Named volumes attached to a container (one per line).
volumes_of() {
  docker inspect "$1" --format \
    '{{range .Mounts}}{{if eq .Type "volume"}}{{println .Name}}{{end}}{{end}}' 2>/dev/null
}

# Other containers (any name) currently attached to a volume, excluding $2.
volume_other_users() {
  docker ps -a --filter "volume=$1" --format '{{.Names}}' \
    | while IFS= read -r n; do [[ -n "$n" && "$n" != "$2" ]] && printf '%s\n' "$n"; done
}

# ---- selector resolution ---------------------------------------------------

# Resolve <selector> to exactly one container name (prints it) or dies.
resolve_one() {
  local sel="$1" n b f
  local -a matches=()

  # exact container-name match wins outright
  while IFS= read -r n; do
    [[ "$n" == "$sel" ]] && { printf '%s\n' "$n"; return 0; }
  done < <(instances)

  # otherwise substring on container name or folder basename
  while IFS= read -r n; do
    [[ -z "$n" ]] && continue
    f=$(folder_of "$n"); b=$(basename "${f:-}" 2>/dev/null || true)
    if [[ "$n" == *"$sel"* || ( -n "$b" && "$b" == *"$sel"* ) ]]; then
      matches+=("$n")
    fi
  done < <(instances)

  case "${#matches[@]}" in
    0) die "no instance matches '$sel' (try: vsc ls)";;
    1) printf '%s\n' "${matches[0]}";;
    *) err "'$sel' is ambiguous; matches:"
       printf '  %s\n' "${matches[@]}" >&2
       exit 1;;
  esac
}

confirm() {
  [[ "${ASSUME_YES:-0}" == 1 ]] && return 0
  local reply
  printf '%s [y/N] ' "$1"
  read -r reply || true
  [[ "$reply" == [yY] || "$reply" == [yY][eE][sS] ]]
}

# ---- commands --------------------------------------------------------------

cmd_ls() {
  local any=0 n st pt fl vols
  printf '%-34s %-9s %-7s %-40s %s\n' "CONTAINER" "STATUS" "PORT" "FOLDER" "VOLUMES"
  while IFS= read -r n; do
    [[ -z "$n" ]] && continue
    any=1
    st=$(status_of "$n")
    pt=$(port_of "$n"); pt=${pt:-"-"}
    fl=$(folder_of "$n"); fl=${fl:-"-"}
    vols=$(volumes_of "$n" | paste -sd, -); vols=${vols:-"-"}
    printf '%-34s %-9s %-7s %-40s %s\n' "$n" "$st" "$pt" "$fl" "$vols"
  done < <(instances)
  [[ "$any" == 0 ]] && note "no vscode instances found"
  return 0
}

cmd_stop() {
  [[ $# -ge 1 ]] || die "usage: vsc stop <selector>"
  local name; name=$(resolve_one "$1")
  if confirm "Stop and remove container '$name'?"; then
    docker rm -f "$name" >/dev/null
    note "removed container $name"
  else
    note "aborted"
  fi
}

# Remove the named volumes for a container. Skips volumes still used by other
# instances unless --force. Requires the volume to be free (docker refuses to
# remove an in-use volume), so the owning container must be gone first.
remove_volumes_of() {
  local name="$1" v others
  local removed=0 skipped=0
  while IFS= read -r v; do
    [[ -z "$v" ]] && continue
    others=$(volume_other_users "$v" "$name")
    if [[ -n "$others" && "${FORCE:-0}" != 1 ]]; then
      err "  skip $v (shared with: $(printf '%s' "$others" | paste -sd, -)) — use --force to remove"
      skipped=$((skipped+1))
      continue
    fi
    if docker volume rm "$v" >/dev/null 2>&1; then
      note "removed volume $v"; removed=$((removed+1))
    else
      err "  could not remove $v (still in use?)"; skipped=$((skipped+1))
    fi
  done < <(volumes_of "$name")
  note "volumes removed: $removed, skipped: $skipped"
}

cmd_rm_volumes() {
  [[ $# -ge 1 ]] || die "usage: vsc rm-volumes <selector>"
  local name; name=$(resolve_one "$1")
  local vols; vols=$(volumes_of "$name")
  [[ -z "$vols" ]] && { note "no named volumes attached to $name"; return 0; }
  err "Volumes attached to $name:"; printf '  %s\n' $vols >&2
  if confirm "Remove these volumes?"; then
    remove_volumes_of "$name"
  else
    note "aborted"
  fi
}

cmd_destroy() {
  [[ $# -ge 1 ]] || die "usage: vsc destroy <selector>"
  local name; name=$(resolve_one "$1")
  # Capture volumes BEFORE removing the container (inspect is impossible after).
  # vscode-cli (shared VS Code server) and vscode-claude-credentials (shared
  # Claude auth) are kept so the next run keeps the server and credentials.
  local v vols=""
  for v in $(volumes_of "$name"); do
    [[ "$v" == "vscode-cli" || "$v" == "vscode-claude-credentials" ]] && continue
    vols+="$v "
  done
  err "About to destroy instance: $name"
  err "  folder (bind mount, NOT deleted): $(folder_of "$name" || true)"
  err "  shared volumes kept: vscode-cli, vscode-claude-credentials"
  [[ -n "$vols" ]] && { err "  volumes to remove:"; printf '    %s\n' $vols >&2; }
  confirm "Stop the container and remove its volumes?" || { note "aborted"; return 0; }

  docker rm -f "$name" >/dev/null
  note "removed container $name"

  local others removed=0 skipped=0
  for v in $vols; do
    others=$(volume_other_users "$v" "$name")
    if [[ -n "$others" && "${FORCE:-0}" != 1 ]]; then
      err "  skip $v (shared with: $(printf '%s' "$others" | paste -sd, -)) — use --force to remove"
      skipped=$((skipped+1)); continue
    fi
    if docker volume rm "$v" >/dev/null 2>&1; then
      note "removed volume $v"; removed=$((removed+1))
    else
      err "  could not remove $v (still in use?)"; skipped=$((skipped+1))
    fi
  done
  note "volumes removed: $removed, skipped: $skipped"
}

usage() {
  cat <<'EOF'
vsc — manage VS Code serve-web instances created by run.sh

An "instance" is a docker container named `vscode-<folder>-<hash>` (see run.sh).
Each instance mounts the project folder as a bind mount at /workspace (your
source code — never deleted here) plus named volumes (vscode-cli,
vscode-claude-credentials) which are SHARED across all instances.

Commands:
  vsc ls                      list instances (status, port, folder, volumes)
  vsc stop       <selector>   stop and remove a running instance (container only)
  vsc rm-volumes <selector>   remove the named volumes attached to an instance
  vsc destroy    <selector>   stop the instance, then remove its volumes

<selector> matches an exact container name, or a substring of the container
name or the project folder name. Ambiguous matches are rejected.

Flags:
  -y, --yes     skip confirmation prompts
  -f, --force   (rm-volumes/destroy) also remove volumes shared with other instances
EOF
}

# ---- arg parsing -----------------------------------------------------------

ASSUME_YES=0
FORCE=0
declare -a POS=()
for a in "$@"; do
  case "$a" in
    -y|--yes)   ASSUME_YES=1;;
    -f|--force) FORCE=1;;
    -h|--help)  usage; exit 0;;
    *)          POS+=("$a");;
  esac
done

[[ ${#POS[@]} -ge 1 ]] || { usage; exit 1; }
cmd="${POS[0]}"; rest=("${POS[@]:1}")

case "$cmd" in
  -h|--help|help)     usage; exit 0;;
esac

require_docker

case "$cmd" in
  ls|list)            cmd_ls;;
  stop|rm)            cmd_stop "${rest[@]+"${rest[@]}"}";;
  rm-volumes|volumes) cmd_rm_volumes "${rest[@]+"${rest[@]}"}";;
  destroy)            cmd_destroy "${rest[@]+"${rest[@]}"}";;
  *)                  err "unknown command: $cmd"; usage; exit 1;;
esac
